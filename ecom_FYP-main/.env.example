# Copy to `.env` and fill in real values. `.env` is gitignored.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256

# Firebase Admin SDK service-account JSON is NOT committed.
# Download it from Firebase Console > Project settings > Service accounts
# and place it beside this file, then point to it:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
