# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit it.

# ---------------------------------------------------------------
# API endpoints
# ---------------------------------------------------------------
# Android emulator reaches the host machine on 10.0.2.2
# Physical device over USB: run `adb reverse tcp:8000 tcp:8000` and use 127.0.0.1
# Physical device over Wi-Fi: use this machine's LAN IP, e.g. http://192.168.1.10:8000
BASE_URL=http://10.0.2.2:8000
CHATBOT_URL=http://10.0.2.2:8001
RECOMMENDATION_URL=http://10.0.2.2:8002

# ---------------------------------------------------------------
# Email (order confirmations)
# ---------------------------------------------------------------
# For Gmail, generate an App Password:
#   Google Account > Security > 2-Step Verification > App passwords
# Prefer sending mail from the backend so this never ships inside the APK.
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
