# API endpoints.
#
# Current setup: a USB-connected phone (TECNO KD7) with `adb reverse` mapping
# the phone's localhost to this PC, so 127.0.0.1 works directly.
#   adb reverse tcp:8000 tcp:8000
#   adb reverse tcp:8001 tcp:8001
#   adb reverse tcp:8002 tcp:8002
# Re-run those after replugging the phone or restarting adb.
#
# On an Android emulator instead, use http://10.0.2.2:<port>
# Over Wi-Fi without adb, use this PC's LAN IP, e.g. http://192.168.18.130:<port>
BASE_URL=http://127.0.0.1:8000
CHATBOT_URL=http://127.0.0.1:8001
RECOMMENDATION_URL=http://127.0.0.1:8002

